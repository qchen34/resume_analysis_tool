GEMINI_API_KEY=your_gemini_api_key_here

# Fast 模型：JD/简历解析、匹配精炼、简历重写
GEMINI_MODEL=gemini-2.0-flash

# Reasoning 模型：职责/任职覆盖度深度分析（可选；不填则使用 GEMINI_MODEL）
GEMINI_REASONING_MODEL=gemini-2.0-pro-exp

DATABASE_URL=sqlite:///./data/resume_analysis.db
LOG_LEVEL=INFO
FORCE_REANALYZE=false

# 简历重写后是否再做一轮「通顺性审核」（默认 true，减轻关键词堆砌）
ENABLE_REWRITE_REVIEW=true

# 分析完成后是否将结果写入数据库（默认 false；需先执行 python -m src.db.init_db 建表）
SAVE_TO_DB=false

# 大牛辩论角色列表（逗号分隔，可选值示例：wangchuan,naval,trump）
DEBATE_PERSONAS=wangchuan,naval,trump
