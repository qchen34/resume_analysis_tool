# ========== 必填 ==========
GEMINI_API_KEY=your_gemini_api_key_here

# ========== 输入文件（可选）==========
# INPUT_DIR：JD/简历所在目录。不填则使用项目根目录下的 input/。可为相对路径（相对项目根）或绝对路径（如 /Users/yourname/jobs）
# INPUT_JD_PATH：JD 文件路径。不填则从 INPUT_DIR 中按文件名含 jd 或 job 自动选取
# INPUT_RESUME_PATH：简历文件路径。不填则从 INPUT_DIR 中按文件名含 resume 或 cv 自动选取
# 路径可为相对项目根（如 input/jd_001.pdf）或绝对路径
# INPUT_DIR=input
# INPUT_JD_PATH=input/daotong_jd.jpeg
# INPUT_RESUME_PATH=input/CV_example.pdf

# 多模态与对话模型：OCR 提取、匹配语义对齐、大牛辩论与合议（如 gemini-2.0-flash / gemini-3-flash-preview）
GEMINI_MODEL=gemini-2.0-flash

# 公司/岗位/行业情报搜索（留空则仅生成查询计划，不实际请求）
TAVILY_API_KEY=

# Tavily 结果过滤：是否只保留摘要中含招聘/求职相关关键词的结果（默认 true，可设 false 关闭）
# TAVILY_FILTER_RESULTS=true

# ========== 可选 ==========
# Reasoning 模型：深度分析等（不填则使用 GEMINI_MODEL）
GEMINI_REASONING_MODEL=

DATABASE_URL=sqlite:///./data/resume_analysis.db
LOG_LEVEL=INFO

# 是否忽略缓存强制重新分析（跳过 OCR/分析结果缓存）
FORCE_REANALYZE=false

# 分析完成后是否写入数据库（默认 true；设 false 可仅生成报告不存库。需先执行 python -m src.db.init_db 建表）
SAVE_TO_DB=true

# ========== 投递 Tracker（可选）==========
# Tracker 使用 applications 表记录每一次投递，可在 Web 前端「投递记录」Tab 中查看/编辑：
# - 每次分析结束后会自动基于 analysis_id 创建一条投递记录（可选，在前端关闭 SAVE_TO_DB 则不写入）
# - 也可以手动新增投递记录或从某次分析预填

# 简历重写后是否做「通顺性审核」（主流程默认不触发重写）
ENABLE_REWRITE_REVIEW=true

# 大牛辩论角色列表（逗号分隔），每人每次随机 50% 看好/50% 看空；前端可多选覆盖
# 政界: mao_zedong, xi_jinping, kim_jongun, trump
# 商界: wangchuan, naval, elon_musk, jack_ma, ma_huateng, zhang_yiming, huang_zheng, dan_koe, annie_duke
# 虚构: chi_dawei, ding_yuanying  历史: socrates, marx, weber, jordan_peterson
DEBATE_PERSONAS=wangchuan,naval,trump
